{{- /* RSS-фид темы — full-text вместо .Summary.

       Что внутри:
       - <description> поста содержит полный .Content (после нашего
         render-hooks pipeline), а не короткое summary;
       - inline CSS в начале <description> делает чтение в RSS-ридерах
         минимально приятным (заголовки, code, blockquote, картинки);
       - <enclosure> для cover-картинки + <media:thumbnail>;
       - <category> для тегов + категорий;
       - всё совместимо с Atom/RSS-парсерами (Feedly, Inoreader, NetNewsWire).

       Управление полнотекстом:
         site.Params.rssFullContent (по умолчанию true) — если false,
         фид выдаёт .Summary, как builtin Hugo. */ -}}
{{- $fullContent := ne (site.Params.rssFullContent | default true) false -}}
{{- $pages := where (where .Site.RegularPages "Type" "in" site.Params.mainSections) "Params.private" "!=" true -}}
{{- $limit := site.Params.rssLimit | default 20 -}}
{{- if and (gt (int $limit) 0) (gt (len $pages) (int $limit)) -}}
  {{- $pages = first $limit $pages -}}
{{- end -}}

{{- /* Inline-CSS для description: читаем из assets/css/rss-inline.css —
       один источник правды, который не уезжает из синка с палитрой
       основной темы. Файл намеренно лежит ВНЕ css/modules/, так что
       не попадает в основной CSS-бандл сайта. */ -}}
{{- $cssRes := resources.Get "css/rss-inline.css" -}}
{{- $css := "" -}}
{{- with $cssRes }}{{ $css = .Content }}{{ end -}}

<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:content="http://purl.org/rss/1.0/modules/content/"
     xmlns:media="http://search.yahoo.com/mrss/"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ if eq  .Title  .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{.}} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ with site.Params.description }}{{ . | plainify }}{{ else }}Recent content {{ with .Title }}{{ printf "in %s " . }}{{ end }}on {{ .Site.Title }}{{ end }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.Lang }}</language>
    {{- with site.Params.author }}
    <copyright>{{ . }}</copyright>
    {{- end }}
    {{- if gt (len $pages) 0 }}
    <lastBuildDate>{{ (index $pages 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />

    {{- range $pages }}
    {{- $cover := "" -}}
    {{- with .Params.cover -}}
      {{- with .image -}}
        {{- $cover = . | absURL -}}
      {{- end -}}
    {{- end -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with .Params.author | default site.Params.author }}
      <dc:creator>{{ . }}</dc:creator>
      {{- end }}
      <guid isPermaLink="true">{{ .Permalink }}</guid>

      {{- range .GetTerms "tags" }}
      <category>{{ .LinkTitle }}</category>
      {{- end }}
      {{- range .GetTerms "categories" }}
      <category domain="category">{{ .LinkTitle }}</category>
      {{- end }}

      {{- with $cover }}
      <enclosure url="{{ . }}" type="image/jpeg" length="0" />
      <media:thumbnail url="{{ . }}" />
      {{- end }}

      {{- /* description и content:encoded оба в CDATA: иначе HTML-сущности
             (`&rsquo;`), HTML void-tags (`<source>`, `<br>`) и любые
             незакрытые теги в нашем рендере ломают XML-парсер RSS.
             Escape `]]>` если он встретится внутри контента — иначе
             CDATA закрывается раньше времени.

             Hugo использует html/template для .xml — поэтому литералы
             `<![CDATA[` он сам html-escape-ит. Собираем строку через
             printf и помечаем результат safeHTML, чтобы Hugo не трогал. */ -}}
      {{- $body := "" -}}
      {{- if $fullContent -}}
        {{- $body = printf "<style>%s</style><div>%s</div>" $css .Content -}}
      {{- else -}}
        {{- $body = printf "%s" .Summary -}}
      {{- end -}}
      {{- $body = replace $body "]]>" "]]]]><![CDATA[>" -}}

      {{ printf "<description><![CDATA[%s]]></description>" $body | safeHTML }}
      {{ printf "<content:encoded><![CDATA[%s]]></content:encoded>" $body | safeHTML }}
    </item>
    {{- end }}
  </channel>
</rss>
